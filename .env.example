EXPO_PUBLIC_AI_MODE=PRODUCTION
# The app only uses the authenticated Supabase `ai` Edge Function.
# Set the Supabase Edge Function secrets AI_MODE=PRODUCTION and
# OPENAI_API_KEY before running the app.
# Public Supabase values only. RLS must stay enabled on every user-owned table.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep privileged keys in Supabase Edge Functions or another server environment.
# Never put service-role, AI, payment, or webhook secrets in EXPO_PUBLIC_* variables.
