EXPO_PUBLIC_AI_MODE=MOCK
# STAGING/PRODUCTION invokes the authenticated Supabase `ai` Edge Function.
# For real AI, set this to PRODUCTION after setting AI_MODE=PRODUCTION and
# OPENAI_API_KEY as Supabase Edge Function secrets.
# Public Supabase values only. RLS must stay enabled on every user-owned table.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep privileged keys in Supabase Edge Functions or another server environment.
# Never put service-role, AI, payment, or webhook secrets in EXPO_PUBLIC_* variables.
