  "cards": [
    {
      "dot": "cyan",
      "title": "Implemented now",
      "items": [
        "Expo Router owns the mobile-first screen flow.",
        "AppStore coordinates consent, analysis, credits, generation jobs, saving, and timeline state.",
        "Consent-gated private media uses user-scoped paths, signed URLs, and selfie metadata.",
        "AsyncStorage and MockAIProvider keep the MVP runnable without backend credentials."
      ]
    },
    {
      "dot": "amber",
      "title": "Production gates",
      "items": [
        "Current slices: Supabase Auth, snapshot/RLS, private media, and durable generation_jobs.",
        "Next: connect a real AI provider and add billing/webhook verification.",
        "Keep EXPO_PUBLIC_* limited to non-secret client configuration."
      ]
    },
    {
      "dot": "rose",
      "title": "Product safety invariants",
      "items": [
        "Selfie use is explicit and consent-gated; adding a photo must not imply consent.",
        "The experience provides supportive, actionable guidance and never an attractiveness score.",
        "Every async generation path needs visible progress, failure recovery, and exactly-once credit settlement."
      ]
    }
  ]
