  "cards": [
    {
      "dot": "cyan",
      "title": "Durable rail",
      "items": [
        "Every job status is persisted in generation_jobs",
        "Provider ids stay attached to the user-owned job row",
        "Polling reads only the current user’s job"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure boundary",
      "items": [
        "Failed is an explicit terminal state",
        "The credits_refunded marker is ready for idempotent settlement",
