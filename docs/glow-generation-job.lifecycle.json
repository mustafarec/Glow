    { "id": "completed", "type": "success", "label": "Completed", "sublabel": "result state persisted", "lane": "main", "col": 4, "step": "03", "tag": "success" },
    { "id": "failed", "type": "failure", "label": "Failed", "sublabel": "error state persisted", "lane": "terminal", "col": 0, "step": "04", "tag": "terminal" }
